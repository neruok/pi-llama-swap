{
  "name": "@neruok/pi-llama-swap",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Named llama-swap providers with dynamic chat and native classifier discovery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neruok/pi-llama-swap.git"
  },
  "homepage": "https://github.com/neruok/pi-llama-swap#readme",
  "bugs": "https://github.com/neruok/pi-llama-swap/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "llama-swap.ts",
    "README.md",
    "llama-swap.example.json",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./llama-swap.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run typecheck && npm test && npm run check:package",
    "prepublishOnly": "npm run verify"
  }
}
